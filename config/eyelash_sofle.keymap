#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

// Swedish layout aliases (host OS set to Swedish, Windows/Linux AltGr mappings).
// ZMK sends US HID positions; these name the character the Swedish layout produces.
#define SE_PLUS       MINUS
#define SE_MINUS      SLASH
#define SE_STAR       LS(BACKSLASH)          // same key as ' on base
#define SE_SLASH      LS(N7)
#define SE_EQL        LS(N0)
#define SE_PRCNT      LS(N5)
#define SE_LPAR       LS(N8)
#define SE_RPAR       LS(N9)
#define SE_AT         RA(N2)
#define SE_DLR        RA(N4)
#define SE_LBRC       RA(N7)
#define SE_LBKT       RA(N8)
#define SE_RBKT       RA(N9)
#define SE_RBRC       RA(N0)
#define SE_BSLH       RA(MINUS)
#define SE_LT         NON_US_BACKSLASH
#define SE_GT         LS(NON_US_BACKSLASH)
#define SE_PIPE       RA(NON_US_BACKSLASH)
#define SE_DEAD_TILDE RA(RIGHT_BRACKET)
#define SE_DEAD_CARET LS(RIGHT_BRACKET)
#define SE_DEAD_GRAVE LS(EQUAL)

// Layer IDs

#define WINDOWS 0
#define WINDOWS_FN   1
#define MAC   2
#define MAC_FN   3
#define GALLIUM 4
#define GALLIUM_FN  5
#define UTILS 6

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;     // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

/ {
    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    behaviors {
        winfn_mt: momentary_or_toggle_win_fn {
            // If held, momentary switch to layer 1 or double tap to toggle layer 1

            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mo 0>, <&tog 0>;
        };

        macfn_mt: momentary_or_toggle_mac_fn {
            // If held, momentary switch to layer 3 or double tap to toggle layer 3

            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mo 0>, <&tog 0>;
        };
    };

    combos {
        compatible = "zmk,combos";

        softoff {
            bindings = <&soft_off>;
            key-positions = <14 28 40>; // Keys Q, S, Z
        };
    };

    macros {
        snap_win: snapshot_win {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_WIN &kp LEFT_SHIFT>,
                <&macro_tap>,
                <&kp S>,
                <&macro_release>,
                <&kp LEFT_COMMAND &kp LEFT_SHIFT>;

            label = "SNAPSHOT_WIN";
        };

        snap_mac_clip: snapshot_mac_clip {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_COMMAND &kp LEFT_CONTROL &kp LEFT_SHIFT>,
                <&macro_tap>,
                <&kp NUMBER_4>,
                <&macro_release>,
                <&kp LEFT_COMMAND &kp LEFT_CONTROL &kp LEFT_SHIFT>;

            label = "SNAPSHOT_MAC_CLIP";
        };

        snap_mac_file: snapshot_mac_file {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_COMMAND &kp LEFT_SHIFT>,
                <&macro_tap>,
                <&kp NUMBER_4>,
                <&macro_release>,
                <&kp LEFT_COMMAND &kp LEFT_SHIFT>;

            label = "SNAPSHOT_MAC_FILE";
        };

        // Swedish dead keys: tap the dead key, then space, to get the bare character
        se_tilde: se_tilde {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp SE_DEAD_TILDE &kp SPACE>;
        };

        se_caret: se_caret {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp SE_DEAD_CARET &kp SPACE>;
        };

        se_grave: se_grave {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp SE_DEAD_GRAVE &kp SPACE>;
        };
    };

    // Bottom left key is the encoder click
    // Column 7 (middle column) is the joystick from the right half

    keymap {
        compatible = "zmk,keymap";

        //
        // Windows layout
        //

        Base {
            bindings = <
&kp ESC     &kp N1     &kp N2    &kp N3  &kp N4    &kp N5      &kp UP     &kp N6     &kp N7     &kp N8     &kp N9         &kp N0         &kp DEL
&kp TAB     &kp Q      &kp W     &kp E   &kp R     &kp T       &kp DOWN   &kp Y      &kp U      &kp I      &kp O          &kp P          &kp LEFT_BRACKET
&kp MINUS   &kp A      &kp S     &kp D   &kp F     &kp G       &kp LEFT   &kp H      &kp J      &kp K      &kp L          &kp SEMI       &kp APOS
&kp LSHFT   &kp Z      &kp X     &kp C   &kp V     &kp B       &kp RIGHT  &kp N      &kp M      &kp COMMA  &kp DOT        &kp SLASH      &kp RSHIFT
&kp C_MUTE  &kp LCTRL  &kp LGUI  &mo 1   &kp LALT  &kp BSPC    &kp ENTER  &kp SPACE  &kp ENTER  &mo 2      &kp RIGHT_ALT  &kp BACKSLASH
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
            display-name = "Base";
        };

        //
        // Mac layout
        //
        //
        // Gallium layout for Windows
        //

        Function {
            bindings = <
&kp ESC  &kp F1        &kp F2        &kp F3        &kp F4  &kp F5      &kp PG_UP   &kp F6       &kp F7       &kp F8       &kp F9       &kp F10      &kp F11
&trans   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &trans  &bt BT_CLR  &kp PG_DN   &se_grave    &kp SE_LPAR  &kp SE_RPAR  &kp SE_EQL   &kp SE_AT    &kp F12
&trans   &trans        &trans        &trans        &trans  &trans      &kp C_PREV  &kp SE_LT    &kp SE_LBRC  &kp SE_RBRC  &kp SE_GT    &kp SE_PIPE  &kp SE_DLR
&trans   &trans        &trans        &trans        &trans  &trans      &kp C_NEXT  &se_tilde    &kp SE_LBKT  &kp SE_RBKT  &se_caret    &kp SE_BSLH  &trans
&trans   &trans        &trans        &trans        &trans  &trans      &kp C_PP    &trans       &trans       &trans       &trans       &trans
            >;

            display-name = "Sym";
        };

        layer_2 {
            bindings = <
&trans  &kp SE_PRCNT  &trans     &trans  &trans  &kp SE_SLASH    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp SE_LPAR   &kp N7     &kp N8  &kp N9  &kp SE_STAR     &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp SE_EQL    &kp N4     &kp N5  &kp N6  &kp SE_MINUS    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp SE_RPAR   &kp N1     &kp N2  &kp N3  &kp SE_PLUS     &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp COMMA     &kp DOT    &kp N0  &trans  &trans          &trans  &trans  &trans  &trans  &trans  &trans
            >;

            display-name = "Num";
        };
    };
};
